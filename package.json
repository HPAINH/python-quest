{
  "name": "python-quest",
  "version": "1.0.0",
  "description": "Python Quest — бесплатный тренажёр Python: уроки, задачи с проверкой в браузере, подсказки и код сохранения",
  "scripts": {
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs",
    "build:content": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^6.1.2",
    "js-yaml": "^5.5.0",
    "pyodide": "^314.0.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
